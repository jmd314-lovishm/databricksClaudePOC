# Databricks MCP Server — runtime configuration.
# Copy to .env and fill in real values. Never commit the populated file.

# ---------------------------------------------------------------------------
# Required: workspace URL
# ---------------------------------------------------------------------------
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# ---------------------------------------------------------------------------
# Required: authentication — pick EXACTLY ONE of the two options below.
# Resolved by the Databricks SDK's standard auth chain.
# ---------------------------------------------------------------------------

# Option A — service principal, OAuth machine-to-machine (recommended for containers)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Option B — personal access token (simpler; tied to a human identity)
# DATABRICKS_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Named profile from ~/.databrickscfg. Local development only — has no effect
# in the container unless the config file is mounted in.
# DATABRICKS_CONFIG_PROFILE=DEFAULT

# Set to any non-empty value for verbose server logging on stderr.
# DATABRICKS_MCP_DEBUG=1

# ---------------------------------------------------------------------------
# MCP transport
# ---------------------------------------------------------------------------
# stdio (default) matches how local MCP clients such as Claude Code launch the
# server. Use http for a long-running networked deployment.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
